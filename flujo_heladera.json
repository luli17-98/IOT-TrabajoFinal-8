  {
    "id": "a1a0000000000012",
    "type": "function",
    "z": "f1a0000000000001",
    "x": 400,
    "y": 300,
    "name": "Analizar lectura",
    "func": "// Leemos los datos que mandó el sensor\nconst t = Number(msg.payload.temperatura);\nconst h = Number(msg.payload.humedad);\nconst LIMITE = 8; // °C máximo permitido\n\nconst hayAlerta = t > LIMITE;\n\n// Salida 1: datos para guardar en la base de datos\nconst paraBD = { params: { $t: t, $h: h, $a: hayAlerta ? 1 : 0 } };\n\n// Salida 2 y 3: datos para el dashboard\nconst temp = { topic: \"Temperatura (°C)\", payload: t };\nconst hum  = { topic: \"Humedad (%)\", payload: h };\n\n// Salida 4: alerta (solo si se pasó del límite)\nlet alerta = null;\nif (hayAlerta) {\n    alerta = { payload: \"ALERTA: la heladera está a \" + t + \" °C (límite \" + LIMITE + \" °C). Se envió la orden ENFRIAR.\" };\n    node.warn(alerta.payload);\n}\n\nnode.status({ fill: hayAlerta ? \"red\" : \"green\", shape: \"dot\", text: t + \" °C\" });\nreturn [paraBD, temp, hum, alerta];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
